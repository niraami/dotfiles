[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	email = istok.public@gmail.com
	name = niraami
# Desktop-only settings (GPG signing, libsecret keyring); git skips it when
# the file is missing, e.g. on headless VMs
[include]
	path = desktop
# Machine-local overrides (e.g. a work identity and signing key), never part
# of the dotfiles; included last so it wins, and skipped when missing
[include]
	path = local
